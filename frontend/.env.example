# Base URL of the Express backend (no trailing slash)
VITE_API_URL=http://localhost:5000

# Set to true only if you are running the patched backend in /backend-patch
# (adds JWT auth, /updateEntry/:id and /deleteEntry/:id). The original
# backend you supplied does NOT support these — leave this false against it.
VITE_ENABLE_EDIT_DELETE=false

# Set to true only if you are running the patched backend, which issues a
# real JWT on /signin. Against the original backend this MUST stay false,
# because that backend never issues a token — the app runs in
# "trusted session" mode instead (see README "Authentication architecture").
VITE_ENABLE_JWT=false
