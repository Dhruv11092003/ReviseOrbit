# --- ReviseOrbit's OWN database (control plane / metadata ONLY) ----------
# This must be a MongoDB you (the operator) own. It stores nothing about
# customer application data — only tenant IDs, access status, and
# encrypted customer database configuration. Never point this at a
# customer's database.
CENTRAL_MONGODB_URI=mongodb+srv://user:pass@your-own-cluster.mongodb.net/reviseorbit_control

# Signs session JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string

# Encrypts customer MongoDB connection strings at rest in the central DB.
# Must decode to exactly 32 bytes. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Your deployed frontend's exact origin (no trailing slash). CORS only
# allows this origin — never leave this as "*" in production.
FRONTEND_URL=https://your-frontend-domain.com

PORT=5000
NODE_ENV=production

# Optional tuning (defaults shown)
MAX_TENANT_CONNECTIONS=50
TENANT_CONNECTION_IDLE_MS=1800000
ENABLE_EDIT_DELETE=true
